# IDE
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
ENV/

# PyInstaller
# Note: keep build/ folder (contains our build scripts)
# Ignore PyInstaller temp files and build outputs
*.spec
*.spec.bak
*.manifest
build/*/
!build/build.py

# Distribution
dist/

# 빌드된 실행 파일 (배포는 GitHub Release asset 으로)
/TrainReservationApp-v*

# Node.js
node_modules/
package-lock.json

# Tailwind CSS build output (regenerated)
app/static/css/output.css

# Logs
*.log

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Screenshots
screenshots/

# Claude Code
.claude/

# 라이선스 서명 개인키 / 발급 대장 — 절대 커밋 금지
# (기본 보관 위치는 저장소 바깥인 ~/.config/private_train/ 이지만, 실수 방지용으로 한 번 더 막는다)
*.pem
*.key
license_signing_key*
issued.jsonl

# 발급된 라이선스는 커밋해야 한다 (앱이 여기서 받아간다).
# 머신에 묶여 있어 공개돼도 남이 쓸 수 없다.
!licenses/*.key
